# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.

# Port for the Express API (and the built client when using `npm start`).
PORT=3001

# SQLite file location, relative to the repository root. Use :memory: for a throwaway database.
DATABASE_PATH=server/data/feedback.sqlite

# Token required in the X-Admin-Token header for GET /api/feedback.
# Leave empty to DISABLE the listing endpoint entirely (recommended default).
ADMIN_TOKEN=

# Optional: allow a separately hosted client origin to call the API (leave empty when using the Vite proxy).
CORS_ORIGIN=

# Rate limit for POST /api/feedback (requests per IP per window).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
